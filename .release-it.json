{
  "$schema": "./node_modules/release-it/schema/release-it.json",
  "hooks": {
    "before:init": "pnpm release:check"
  },
  "git": {
    "commitMessage": "chore(release): v${version}",
    "requireBranch": "main",
    "requireCleanWorkingDir": true,
    "requireCommits": true,
    "tagName": "v${version}"
  },
  "github": {
    "release": false
  },
  "npm": {
    "publish": true
  }
}
